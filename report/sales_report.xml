<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="report_qty_salequotation_document">
        <t t-call="web.external_layout">
            <t t-set="doc"
                t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <t t-set="address">
                <div t-field="doc.partner_id"
                    t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />
                <p t-if="doc.partner_id.vat">
                    <t t-esc="doc.company_id.country_id.vat_label or 'ID Fiscal'" />
:                    <span t-field="doc.partner_id.vat" />
                </p>
            </t>

            <div t-if="doc.partner_shipping_id or doc.partner_invoice_id"
                id="informations_block">
                <div class="row">
                    <div class="col-6"
                        t-if="doc.partner_invoice_id and doc.partner_invoice_id != doc.partner_id">
                        <strong t-if="doc.partner_shipping_id == doc.partner_invoice_id">Dirección de facturación y envío:</strong>
                        <strong t-if="doc.partner_shipping_id != doc.partner_invoice_id">Dirección de facturación:</strong>
                        <div t-field="doc.partner_invoice_id"
                            t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}' />
                    </div>
                    <div class="col-6"
                        t-if="doc.partner_shipping_id and doc.partner_shipping_id != doc.partner_invoice_id and doc.partner_shipping_id != doc.partner_id">
                        <strong>Dirección de envío:</strong>
                        <div t-field="doc.partner_shipping_id"
                            t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}' />
                    </div>
                </div>
            </div>

            <div class="page">
                <div class="oe_structure" />

                <h2 class="o_sub_header">
                    <t t-if="not (env.context.get('proforma', False) or is_pro_forma)">
                        <span t-if="doc.state not in ['draft','sent']">Pedido # </span>
                        <span t-if="doc.state in ['draft','sent']">Cotización # </span>
                    </t>
                    <t t-if="env.context.get('proforma', False) or is_pro_forma">
                        <span>Factura Proforma # </span>
                    </t>
                    <span t-field="doc.name" />
                </h2>

                <div id="informations"
                    class="row mt32 mb32 o_background_header">
                    <div t-if="doc.client_order_ref"
                        class="col-auto mw-100 mb-2">
                        <strong>Su referencia:</strong>
                        <p class="m-0"
                            t-field="doc.client_order_ref" />
                    </div>
                    <div t-if="doc.confirmation_date and doc.state not in ['draft','sent']"
                        class="col-auto mw-100 mb-2">
                        <strong>Fecha de pedido:</strong>
                        <p class="m-0"
                            t-field="doc.confirmation_date" />
                    </div>
                    <div t-if="doc.date_order and doc.state in ['draft','sent']"
                        class="col-auto mw-100 mb-2">
                        <strong>Fecha de cotización:</strong>
                        <p class="m-0"
                            t-field="doc.date_order" />
                    </div>
                    <div t-if="doc.user_id"
                        class="col-auto mw-100 mb-2">
                        <strong>Vendedor:</strong>
                        <p class="m-0"
                            t-field="doc.user_id" />
                    </div>
                    <div name="payment_term"
                        t-if="doc.payment_term_id"
                        class="col-auto mw-100 mb-2">
                        <strong>Condiciones de pago:</strong>
                        <p class="m-0"
                            t-field="doc.payment_term_id" />
                    </div>
                    <div t-if="doc.validity_date and doc.state in ['draft', 'sent']"
                        class="col-auto mw-100 mb-2">
                        <strong>Fecha de vencimiento:</strong>
                        <p class="m-0"
                            t-field="doc.validity_date" />
                    </div>
                </div>

                <t t-set="display_discount"
                    t-value="any([l.discount for l in doc.order_line])" />

                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <t t-set="colspan"
                                t-value="5" />
                            <th name="th_description"
                                class="text-start">Descripción</th>
                            <th name="th_quantity"
                                class="text-end">Cantidad entregada</th>
                            <th name="th_priceunit"
                                class="text-end">Precio unitario</th>
                            <th name="th_discount"
                                t-if="display_discount"
                                class="text-end"
                                groups="sale.group_discount_per_so_line">
                                <span>Desc.(%)</span>
                                <t t-set="colspan"
                                    t-value="colspan+1" />
                            </th>
                            <th name="th_taxes"
                                class="text-end">Impuestos</th>
                            <th name="th_subtotal"
                                class="text-end">
                                <span groups="account.group_show_line_subtotals_tax_excluded">Monto</span>
                                <span groups="account.group_show_line_subtotals_tax_included">Precio total</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">

                        <t t-foreach="doc.order_line"
                            t-as="line">

                            <t t-set="delivered_subtotal"
                                t-value="line.qty_delivered * line.price_unit * (1 - (line.discount or 0.0) / 100.0)" />

                            <tr t-att-class="{'bg-200 fw-bold o_line_section': line.display_type == 'line_section', 'font-italic o_line_note': line.display_type == 'line_note'}">
                                <t t-if="not line.display_type">
                                    <td name="td_name">
                                        <span t-field="line.name" />
                                    </td>
                                    <td name="td_quantity"
                                        class="text-end">
                                        <span t-field="line.qty_delivered" />
                                        <span t-field="line.product_uom"
                                            groups="uom.group_uom" />
                                    </td>
                                    <td name="td_priceunit"
                                        class="text-end">
                                        <span t-field="line.price_unit"
                                            t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}' />
                                    </td>
                                    <td t-if="display_discount"
                                        class="text-end"
                                        groups="sale.group_discount_per_so_line">
                                        <span t-field="line.discount" />
                                    </td>
                                    <td name="td_taxes"
                                        class="text-end">
                                        <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_id))" />
                                    </td>
                                    <td name="td_subtotal"
                                        class="text-end o_price_total">
                                        <span t-esc="delivered_subtotal"
                                            groups="account.group_show_line_subtotals_tax_excluded"
                                            t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}' />
                                        <span t-esc="line.price_total"
                                            groups="account.group_show_line_subtotals_tax_included"
                                            t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}' />
                                    </td>
                                </t>
                                <t t-if="line.display_type == 'line_section'">
                                    <td name="td_section_line"
                                        t-att-colspan="colspan">
                                        <span t-field="line.name" />
                                    </td>
                                </t>
                                <t t-if="line.display_type == 'line_note'">
                                    <td name="td_note_line"
                                        t-att-colspan="colspan">
                                        <span t-field="line.name" />
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="clearfix">
                    <div id="total"
                        class="row"
                        name="total">
                        <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ml-auto">
                            <table class="table table-sm">
                                <tr class="border-black o_subtotal"
                                    style="">
                                    <td name="td_amount_untaxed_label">
                                        <strong>Subtotal</strong>
                                    </td>
                                    <td name="td_amount_untaxed"
                                        class="text-end">
                                        <span t-field="doc.price_subtotal_qty_delivered"
                                            t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}' />
                                    </td>
                                </tr>

                                <t t-foreach="doc.qty_delivered_amount_by_group"
                                    t-as="amount_by_group">
                                    <tr style="">
                                        <td name="td_amount_by_group_label">
                                            <span t-esc="amount_by_group[0]" />
                                        </td>
                                        <td name="td_amount_by_group"
                                            class="text-end o_price_total">
                                            <span t-esc="amount_by_group[1]"
                                                t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}' />
                                        </td>
                                    </tr>
                                </t>

                                <tr class="border-black o_total">
                                    <td name="td_amount_total_label">
                                        <strong>Total</strong>
                                    </td>
                                    <td name="td_amount_total"
                                        class="text-end">
                                        <span t-field="doc.price_total_qty_delivered"
                                            t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}' />
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <p t-field="doc.note" />
                <p t-if="doc.payment_term_id.note">
                    <span t-field="doc.payment_term_id.note" />
                </p>
                <p id="fiscal_position_remark"
                    t-if="doc.fiscal_position_id and doc.fiscal_position_id.sudo().note">
                    <strong>Observación de la posición fiscal:</strong>
                    <span t-field="doc.fiscal_position_id.sudo().note" />
                </p>

                <div t-if="doc.signature"
                    class="mt32 ml-4 me-4"
                    name="signature">
                    <div class="offset-8">
                        <strong>Firma</strong>
                    </div>
                    <div class="offset-8">
                        <img t-att-src="image_data_uri(doc.signature)"
                            style="max-height: 4cm; max-width: 8cm;" />
                    </div>
                    <div class="offset-8 text-center">
                        <p t-field="doc.signed_by" />
                    </div>
                </div>

                <div class="oe_structure" />
            </div>
        </t>
    </template>

    <template id="report_qty_salequotation">
        <t t-call="web.html_container">
            <t t-foreach="docs"
                t-as="doc">
                <t t-call="qty_delivery_report.report_qty_salequotation_document"
                    t-lang="doc.partner_id.lang" />
            </t>
        </t>
    </template>

    <record id="report_qty_sale_quotation"
        model="ir.actions.report">
        <field name="name">Cotización de productos entregados (PDF)</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">qty_delivery_report.report_qty_salequotation</field>
        <field name="report_file">Cotizacion de productos entregados (PDF)</field>
        <field name="binding_model_id"
            ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Cotización - %s' % (object.name)) or 'Orden - %s' % (object.name)'</field>
    </record>
</odoo>